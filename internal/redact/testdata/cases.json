   "expected": "password   =   [REDACTED:PASSWORD]"
  },
  {
   "name": "kc_two_same_key_different_values",
   "input": "password=FakePass111 password=FakePass222",
   "expected": "password=[REDACTED:PASSWORD] password=[REDACTED:PASSWORD_2]"
  },
  {
   "name": "kc_two_same_key_same_value",
   "input": "password=FakePass111 password=FakePass111",
   "expected": "password=[REDACTED:PASSWORD] password=[REDACTED:PASSWORD]"
  },
  {
   "name": "kc_key_prefix_char_blocks",
   "input": "xx-token=fake-token-1234 +token=fake-token-5678",
   "expected": "xx-token=[REDACTED:XX_TOKEN] +token=[REDACTED:TOKEN]"
  },
  {
   "name": "kc_dollar_prefix_blocks",
   "input": "$token=fake-token-1234",
   "expected": "$token=fake-token-1234"
  },
  {
