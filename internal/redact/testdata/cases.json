{
 "about": "Golden cases produced by running the Pegasus redactor (engram-hook.py cut_to_detect_cap + redact) with _token -> [REDACTED:NAME] and one extra placeholder pattern ^\\[REDACTED:[A-Z0-9_]+\\]$. All values are synthetic.",
 "cases": [
  {
   "name": "never_git_sha1",
   "input": "commit a1b2c3d4e5a1b2c3d4e5a1b2c3d4e5a1b2c3d4e5 fixed it",
   "expected": "commit a1b2c3d4e5a1b2c3d4e5a1b2c3d4e5a1b2c3d4e5 fixed it"
  },
  {
   "name": "never_sha256",
   "input": "sha256: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
   "expected": "sha256: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  },
  {
   "name": "never_uuid",
   "input": "id 123e4567-e89b-12d3-a456-426614174000 done",
   "expected": "id 123e4567-e89b-12d3-a456-426614174000 done"
  },
  {
   "name": "never_plain_number",
   "input": "pid 1234567890123 port 8080",
   "expected": "pid 1234567890123 port 8080"
  },
  {
   "name": "never_plain_text",
   "input": "just a normal sentence about tokens and passwords, nothing else.",
   "expected": "just a normal sentence about tokens and passwords, nothing else."
  },
  {
   "name": "empty",
   "input": "",
   "expected": ""
  },
  {
   "name": "never_hash_after_key_like_word",
   "input": "digest of the token list is fine",
   "expected": "digest of the token list is fine"
  },
  {
   "name": "known_openai",
   "input": "key sk-F4K3F4K3F4K3F4K3F4K3F4K3F4K3 end",
   "expected": "key [REDACTED:OPENAI_KEY] end"
  },
  {
   "name": "known_openai_too_short",
   "input": "key sk-F4K3F4K3F4 end",
   "expected": "key sk-F4K3F4K3F4 end"
  },
  {
   "name": "known_github_ghp",
   "input": "use ghp_F4K3F4K3F4K3F4K3F4K3F4K3F4K3F4 now",
   "expected": "use [REDACTED:GITHUB_TOKEN] now"
  },
  {
   "name": "known_github_gho",
   "input": "use gho_F4K3F4K3F4K3F4K3F4K3F4K3 now",
   "expected": "use [REDACTED:GITHUB_TOKEN] now"
  },
  {
   "name": "known_github_pat",
   "input": "use github_pat_F4K3_F4K3_F4K3_F4K3_F4K3_F4K3_ now",
   "expected": "use [REDACTED:GITHUB_TOKEN] now"
  },
  {
   "name": "known_aws",
   "input": "id AKIAFAKEFAKEFAKE1234 tail",
   "expected": "id [REDACTED:AWS_ACCESS_KEY] tail"
  },
  {
   "name": "known_aws_wrong_length",
   "input": "id AKIAFAKEFAKE tail",
   "expected": "id AKIAFAKEFAKE tail"
  },
  {
   "name": "known_slack",
   "input": "tok xoxb-1234567890-FAKEFAKE end",
   "expected": "tok [REDACTED:SLACK_TOKEN] end"
  },
  {
   "name": "known_jwt",
   "input": "jwt eyJFAKEhdr.eyJFAKEpay.FAKEsig_-x end",
   "expected": "jwt [REDACTED:JWT] end"
  },
  {
   "name": "known_private_key_block",
   "input": "before\n-----BEGIN RSA PRIVATE KEY-----\nFAKEFAKEFAKEFAKE\nFAKEFAKE\n-----END RSA PRIVATE KEY-----\nafter",
   "expected": "before\n[REDACTED:PRIVATE_KEY_BLOCK]\nafter"
  },
  {
   "name": "known_private_key_block_plain",
   "input": "-----BEGIN PRIVATE KEY-----\nFAKE\nFAKEFAKE\n-----END PRIVATE KEY-----",
   "expected": "[REDACTED:PRIVATE_KEY_BLOCK]"
  },
  {
   "name": "known_private_key_unclosed",
   "input": "-----BEGIN PRIVATE KEY-----\nFAKEFAKEFAKE no end",
   "expected": "-----BEGIN PRIVATE KEY-----\nFAKEFAKEFAKE no end"
  },
  {
   "name": "known_repeated_same_value",
   "input": "a sk-F4K3F4K3F4K3F4K3F4K3F4K3 b sk-F4K3F4K3F4K3F4K3F4K3F4K3 c",
   "expected": "a [REDACTED:OPENAI_KEY] b [REDACTED:OPENAI_KEY] c"
  },
  {
   "name": "known_two_distinct_same_name",
   "input": "a sk-F4K3F4K3F4K3F4K3F4K3F4K3 b sk-N0PEN0PEN0PEN0PEN0PEN0PE c",
   "expected": "a [REDACTED:OPENAI_KEY] b [REDACTED:OPENAI_KEY_2] c"
  },
  {
   "name": "kc_json_double",
   "input": "{\"password\": \"FakePass123\", \"user\": \"bob\"}",
   "expected": "{\"password\": \"[REDACTED:PASSWORD]\", \"user\": \"bob\"}"
  },
  {
   "name": "kc_json_no_space",
   "input": "{\"api_key\":\"FAKE-api-key-1\"}",
   "expected": "{\"api_key\":\"[REDACTED:API_KEY]\"}"
  },
  {
   "name": "kc_json_access_token",
   "input": "{\"access_token\": \"fake-access-token-9\"}",
   "expected": "{\"access_token\": \"[REDACTED:ACCESS_TOKEN]\"}"
  },
  {
   "name": "kc_json_short_value",
   "input": "{\"token\": \"abc\"}",
   "expected": "{\"token\": \"abc\"}"
  },
  {
   "name": "kc_json_min_len_4",
   "input": "{\"token\": \"abcd\"}",
   "expected": "{\"token\": \"[REDACTED:TOKEN]\"}"
  },
  {
   "name": "kc_json_other_key",
   "input": "{\"username\": \"fakeusername123\"}",
   "expected": "{\"username\": \"fakeusername123\"}"
  },
  {
   "name": "kc_json_compound_key",
   "input": "{\"db-password\": \"fakepassword123\", \"x_api_key\": \"fake-key-value\"}",
   "expected": "{\"db-password\": \"[REDACTED:DB_PASSWORD]\", \"x_api_key\": \"[REDACTED:X_API_KEY]\"}"
  },
  {
   "name": "kc_json_nested",
   "input": "{\"auth\": {\"client_secret\": \"fake-client-secret-1\"}, \"n\": 1}",
   "expected": "{\"auth\": {\"client_secret\": \"[REDACTED:CLIENT_SECRET]\"}, \"n\": 1}"
  },
  {
   "name": "kc_dq_equals",
   "input": "password=\"FakePass123\"",
   "expected": "password=\"[REDACTED:PASSWORD]\""
  },
  {
   "name": "kc_dq_colon",
   "input": "token: \"fake-token-value1\"",
   "expected": "token: \"[REDACTED:TOKEN]\""
  },
  {
   "name": "kc_sq_equals",
   "input": "secret='fake-secret-val1'",
   "expected": "secret='[REDACTED:SECRET]'"
  },
  {
   "name": "kc_sq_colon",
   "input": "api_key: 'fake-api-key-12'",
   "expected": "api_key: '[REDACTED:API_KEY]'"
  },
  {
   "name": "kc_quoted_with_spaces",
   "input": "password=\"a fake pass phrase 1\"",
   "expected": "password=\"[REDACTED:PASSWORD]\""
  },
  {
   "name": "kc_unquoted_equals",
   "input": "password=FakePass123 next",
   "expected": "password=[REDACTED:PASSWORD] next"
  },
  {
   "name": "kc_unquoted_colon",
   "input": "token: fake-token-value1",
   "expected": "token: [REDACTED:TOKEN]"
  },
  {
   "name": "kc_unquoted_env_style",
   "input": "export API_KEY=fake-api-key-12",
   "expected": "export API_KEY=[REDACTED:API_KEY]"
  },
  {
   "name": "kc_unquoted_url_query",
   "input": "https://example.test/cb?token=fake-token-1234&x=1",
   "expected": "https://example.test/cb?token=[REDACTED:TOKEN]&x=1"
  },
  {
   "name": "kc_unquoted_min_len_4",
   "input": "token=abcd and more",
   "expected": "token=abcd and more"
  },
  {
   "name": "kc_unquoted_below_min",
   "input": "token=abc and more",
   "expected": "token=abc and more"
  },
  {
   "name": "kc_unquoted_value_class_stop",
   "input": "password=fake1234,rest",
   "expected": "password=[REDACTED:PASSWORD],rest"
  },
  {
   "name": "kc_case_insensitive_key",
   "input": "PASSWORD=FakePass123 Token=fake-token-12",
   "expected": "PASSWORD=[REDACTED:PASSWORD] Token=[REDACTED:TOKEN]"
  },
  {
   "name": "kc_camel_key_not_matched",
   "input": "accessToken=fake-token-1234",
   "expected": "accessToken=[REDACTED:ACCESSTOKEN]"
  },
  {
   "name": "kc_snake_prefixed",
   "input": "my_refresh_token=fake-refresh-1234",
   "expected": "my_refresh_token=[REDACTED:MY_REFRESH_TOKEN]"
  },
  {
   "name": "kc_private_key_name",
   "input": "private_key=fake-private-key-1",
   "expected": "private_key=[REDACTED:PRIVATE_KEY]"
  },
  {
   "name": "kc_signature_name",
